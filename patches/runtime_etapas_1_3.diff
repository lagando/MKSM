             g_cdStreamingLbn = selected.lbn + selected.sectors;
+
+            // Diagnóstico de progresso: sceCdRead não loga em caso de sucesso,
+            // então um jogo que só lê dados parece "parado". Registra as
+            // primeiras leituras e um resumo a cada 64 MB.
+            static uint32_t s_okLogCount = 0u;
+            static uint64_t s_totalBytesRead = 0ull;
+            static uint64_t s_nextProgressLog = 64ull * 1024ull * 1024ull;
+            const uint64_t readBytes =
+                static_cast<uint64_t>(selected.sectors) * static_cast<uint64_t>(kCdSectorSize);
+            s_totalBytesRead += readBytes;
+            if (s_okLogCount < 16u)
+            {
+                RUNTIME_LOG("[sceCdRead:ok] pc=0x" << std::hex << ctx->pc
+                                                   << " ra=0x" << getRegU32(ctx, 31)
+                                                   << " lbn=0x" << selected.lbn
+                                                   << " sectors=0x" << selected.sectors
+                                                   << " buf=0x" << selected.buf
+                                                   << std::dec << " tag=" << selected.tag
+                                                   << std::endl);
+                ++s_okLogCount;
+            }
+            if (s_totalBytesRead >= s_nextProgressLog)
+            {
+                RUNTIME_LOG("[sceCdRead:progress] totalMB=" << (s_totalBytesRead / (1024ull * 1024ull))
+                                                            << " lastLbn=0x" << std::hex << selected.lbn
+                                                            << std::dec << std::endl);
+                while (s_nextProgressLog <= s_totalBytesRead)
+                    s_nextProgressLog += 64ull * 1024ull * 1024ull;
+            }
+
             setReturnS32(ctx, 1); // command accepted/success
             return;
         }
