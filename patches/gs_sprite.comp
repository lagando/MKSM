#version 450
// GS sprites of the CPU fast path (GSCpuBackend::DrawSprite, simplePixels &&
// simpleTexture): CT32 frame, no Z, alpha test, mask, fog or filtering; optional CT32
// DECAL texture. Same integer arithmetic as the CPU so the VRAM comes out identical.
// Texel coordinates come per column/row from the CPU (uvTable), which keeps the float
// division of the CPU path exact.

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) buffer Vram { uint vram[]; };              // 4 MB of GS local memory
layout(std430, binding = 1) readonly buffer Snapshot { uint snapshot[]; }; // pages copied before a feedback sprite
layout(std430, binding = 2) readonly buffer Swizzle { uint swizzleCT32[]; }; // [y % 32][x % 64] -> BlockId * 64 + ColumnId
layout(std430, binding = 3) readonly buffer UvTable { int uvTable[]; };

// A batch of sprites, one per workgroup layer (gl_WorkGroupID.z). The CPU only batches
// sprites that neither overlap each other's writes nor read what another one writes
// (feedback sprites read the snapshot, copied before the batch), so the layers are
// independent and the result matches drawing them one by one.
layout(push_constant) uniform Batch
{
    uint descBase;   // uvTable index of the first 16-word descriptor
    uint count;
} pc;

// Descriptor words: x0, y0, x1, y1 (inclusive, scissored), fbBlock, fbWidth, source (RGBA
// of v1), alphaMode (ALPHA bits 0..7), alphaFix, flags (1 ABE, 2 TME, 4 TCC, 8 texture
// from snapshot), texBlock, texWidth (TBW as given), uvOffsetU (uvTable index of column
// x0), uvOffsetV (of row y0).
const uint kMemoryWords = 4u * 1024u * 1024u / 4u;

uint addressCT32(uint block, uint width, uint x, uint y)
{
    const uint page = block / 32u + (y / 32u) * ((width * 64u) / 64u) + x / 64u;
    const uint word = page * 2048u + (block % 32u) * 64u + swizzleCT32[(y % 32u) * 64u + (x % 64u)];
    return word & (kMemoryWords - 1u);
}

int pick(uint sel, int cs, int cd)
{
    return sel == 0u ? cs : sel == 1u ? cd : 0;
}

void main()
{
    const uint d = pc.descBase + gl_WorkGroupID.z * 16u;
    const ivec4 drawRect = ivec4(uvTable[d], uvTable[d + 1u], uvTable[d + 2u], uvTable[d + 3u]);
    const uint fbBlock = uint(uvTable[d + 4u]), fbWidth = uint(uvTable[d + 5u]), source = uint(uvTable[d + 6u]);
    const uint alphaMode = uint(uvTable[d + 7u]), alphaFix = uint(uvTable[d + 8u]), flags = uint(uvTable[d + 9u]);
    const uint texBlock = uint(uvTable[d + 10u]), texWidth = uint(uvTable[d + 11u]);
    const uint uvOffsetU = uint(uvTable[d + 12u]), uvOffsetV = uint(uvTable[d + 13u]);

    const int x = drawRect.x + int(gl_GlobalInvocationID.x);
    const int y = drawRect.y + int(gl_GlobalInvocationID.y);
    if (x > drawRect.z || y > drawRect.w)
        return;

    uint src = source;
    if ((flags & 2u) != 0u)
    {
        const uint u = uint(uvTable[uvOffsetU + uint(x - drawRect.x)]);
        const uint v = uint(uvTable[uvOffsetV + uint(y - drawRect.y)]);
        const uint at = addressCT32(texBlock, texWidth, u, v);
        const uint texel = (flags & 8u) != 0u ? snapshot[at] : vram[at];
        src = (flags & 4u) != 0u ? texel : ((texel & 0x00FFFFFFu) | (source & 0xFF000000u));
    }

    const uint at = addressCT32(fbBlock, fbWidth, uint(x), uint(y));
    uint result = src;
    if ((flags & 1u) != 0u)
    {
        const uint dest = vram[at];
        const uint asel = alphaMode & 3u, bsel = (alphaMode >> 2) & 3u;
        const uint csel = (alphaMode >> 4) & 3u, dsel = (alphaMode >> 6) & 3u;
        const int cAlpha = csel == 0u ? int(src >> 24) : csel == 1u ? int(dest >> 24) : int(alphaFix);
        result = src & 0xFF000000u;
        for (uint shift = 0u; shift < 24u; shift += 8u)
        {
            const int cs = int((src >> shift) & 0xFFu), cd = int((dest >> shift) & 0xFFu);
            const int value = (((pick(asel, cs, cd) - pick(bsel, cs, cd)) * cAlpha) >> 7) + pick(dsel, cs, cd);
            result |= uint(clamp(value, 0, 255)) << shift;
        }
    }
    vram[at] = result;
}
