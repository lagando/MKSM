 void VU1Interpreter::advanceTo(uint64_t targetCycle)
 {
     while (m_cycle < targetCycle)
+    {
+        // Nothing commits before the next ready cycle: jump to it, giving PATH1 the
+        // cycles in between at once (it only reads VU memory, which they leave alone).
+        const uint64_t next = std::min(targetCycle, m_nextPipelineCycle);
+        if (next > m_cycle + 1u)
+        {
+            const uint64_t skipped = next - 1u - m_cycle;
+            m_cycle = next - 1u;
+            m_state.cycles = m_cycle;
+            if (m_xgkick.active)
+            {
+                m_xgkick.cycleCredit += static_cast<decltype(m_xgkick.cycleCredit)>(skipped - 1u);
+                progressXgkick(); // adds the last skipped cycle and consumes the credit
+            }
+        }
         advanceOneCycle();
+    }
 }
 
