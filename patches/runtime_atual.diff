+void GSCpuBackend::DrawFeedbackPrimitive(const GSPrimitiveBatch &batch)
+{
+    constexpr uint32_t kPageBytes = 8192u;
+    thread_local std::vector<uint32_t> pages;
+    FeedbackPages(batch, pages);
+    if (m_feedbackVram.size() != m_vramSize)
+        m_feedbackVram.resize(m_vramSize);
+    for (const uint32_t page : pages)
+        std::memcpy(m_feedbackVram.data() + page * kPageBytes, m_vram + page * kPageBytes, kPageBytes);
+
+    // Every pixel reads the snapshot, never this primitive's own writes, so the
+    // bands can share its rows (the bloom sends ~700 of these a frame).
+    m_textureVram = m_feedbackVram.data();
+    std::vector<const GSPrimitiveBatch *> single{&batch};
+    uint64_t forceParallel = kParallelMinPixels;
+    RunDrawSegment(single, forceParallel);
+    m_textureVram = m_vram;
+}
