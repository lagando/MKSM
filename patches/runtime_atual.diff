+
+PadBinding *padBindings(int player)
+{
+    static PadBinding tables[2][kPadBindingCount];
+    static const bool loaded = []
+    {
+        const PadBinding *defaults = padBindingDefaults();
+        for (int i = 0; i < kPadBindingCount; ++i)
+        {
+            PadBinding *table = tables[0];
+            table[i] = tables[1][i] = defaults[i];
+            const std::string name = defaults[i].iniName;
+            if (const char *v = std::getenv(("PS2X_PAD2_" + name).c_str())) // controle 2 (genéricos mapeiam diferente)
+                tables[1][i].gamepad = std::clamp(std::atoi(v), 0, static_cast<int>(GAMEPAD_BUTTON_RIGHT_THUMB));
+            if (const char *v = std::getenv(("PS2X_PAD_" + name).c_str()))
+                table[i].gamepad = std::clamp(std::atoi(v), 0, static_cast<int>(GAMEPAD_BUTTON_RIGHT_THUMB));
+            if (const char *v = std::getenv(("PS2X_TECLA_" + name).c_str()))
+            {
+                const char *comma = std::strchr(v, ',');
+                table[i].key = std::clamp(std::atoi(v), 0, 511);
+                table[i].key2 = comma ? std::clamp(std::atoi(comma + 1), 0, 511) : 0;
+            }
+        }
+        return true;
+    }();
+    (void)loaded;
+    return tables[player == 1 ? 1 : 0];
+}
