+void GSCpuBackend::BandLoop(uint32_t bandIndex)
+{
+    t_bandIndex = bandIndex;
+    t_bandCount = m_bandTotal;
+    uint64_t seenGeneration = 0u;
+    while (true)
+    {
+        // A frame has around 100 segments: spin through the gaps instead of paying
+        // a futex wake for each one, and sleep only when the GS really goes idle.
+        for (uint32_t spin = 0u; spin < kBandSpinCount && m_bandGeneration.load(std::memory_order_acquire) == seenGeneration; ++spin)
+            _mm_pause();
+        if (m_bandGeneration.load(std::memory_order_acquire) == seenGeneration)
+        {
+            std::unique_lock<std::mutex> lock(m_bandMutex);
+            m_bandCv.wait(lock, [&]
+                          { return m_stopBands || m_bandGeneration.load(std::memory_order_acquire) != seenGeneration; });
+            if (m_stopBands)
+                return;
+        }
+        seenGeneration = m_bandGeneration.load(std::memory_order_acquire);
+        for (const GSPrimitiveBatch *batch : *m_bandSegment)
+            DrawPrimitive(*batch);
+        m_bandPending.fetch_sub(1u, std::memory_order_acq_rel);
+    }
+}
+
+void GSCpuBackend::RunDrawSegment(std::vector<const GSPrimitiveBatch *> &segment, uint64_t &pixelEstimate)
+{
+    if (!m_bandThreads.empty() && pixelEstimate >= kParallelMinPixels)
+    {
+        const uint32_t helpers = static_cast<uint32_t>(m_bandThreads.size());
+        m_bandSegment = &segment;
+        m_bandPending.store(helpers, std::memory_order_release);
+        {
+            std::lock_guard<std::mutex> lock(m_bandMutex);
+            m_bandGeneration.fetch_add(1u, std::memory_order_acq_rel);
+        }
+        m_bandCv.notify_all();
+        t_bandIndex = 0u;
+        t_bandCount = helpers + 1u;
+        for (const GSPrimitiveBatch *batch : segment)
+            DrawPrimitive(*batch);
+        t_bandCount = 1u;
+        while (m_bandPending.load(std::memory_order_acquire) != 0u)
+            _mm_pause();
+    }
+    else
+    {
+        for (const GSPrimitiveBatch *batch : segment)
+            DrawPrimitive(*batch);
+    }
+    segment.clear();
+    pixelEstimate = 0u;
+}
