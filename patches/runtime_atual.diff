+    for (uint32_t i = 0u; i < batch.vertexCount; ++i)
+    {
+        const GSVertex &v = batch.vertices[i];
+        const float invQ = state.prim.fst ? 1.0f : 1.0f / fabsQ(v.q);
+        const float u = state.prim.fst ? v.u / 16.0f : v.s * invQ * texW;
+        const float t = state.prim.fst ? v.v / 16.0f : v.t * invQ * texH;
+        minU = std::min(minU, u), maxU = std::max(maxU, u);
+        minV = std::min(minV, t), maxV = std::max(maxV, t);
