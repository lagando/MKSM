+bool EeScheduler::idleCheckpoint() noexcept
+{
+    // The loop only waits for an interrupt to change memory, so jump the clock to the
+    // next event instead of spinning 32 cycles per lap (PCSX2's idle loop skip).
+    // MKSM_NO_IDLE_SKIP=1 restores the plain checkpoint.
+    static const bool disabled = std::getenv("MKSM_NO_IDLE_SKIP") != nullptr;
+    uint64_t cycles = kGeneratedCheckpointCycles;
+    const uint64_t nextEventCycle = m_nextDeadlineCycle.load(std::memory_order_acquire);
+    if (!disabled && nextEventCycle > m_eeCycle)
+        cycles = std::clamp<uint64_t>(nextEventCycle - m_eeCycle, kGeneratedCheckpointCycles, kVBlankPeriodCycles);
+    // Stop at the next EE timer event: a jump past it delivers the interrupt late (game hung at load).
+    if (m_eeTimerBatchLimit > m_eeTimerPendingCycles)
+        cycles = std::max<uint64_t>(kGeneratedCheckpointCycles, std::min<uint64_t>(cycles, m_eeTimerBatchLimit - m_eeTimerPendingCycles));
+    return checkpointDue(static_cast<uint32_t>(cycles));
