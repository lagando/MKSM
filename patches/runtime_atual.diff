+    // Controles tab, waiting for a press: the first gamepad button or key takes the PS2 button; a host
+    // button already used by another one swaps with it. F1 and F9-F12 belong to the window; Backspace cancels.
+    void updateCapture()
+    {
+        GfxMenu &m = g_gfxMenu;
+        PadBinding *bindings = padBindings(m.pad);
+        PadBinding &b = bindings[m.capture];
+        const bool padOk = IsGamepadAvailable(m.pad);
+        if (!m.captureArmed) // the press that started it must be let go first
+        {
+            bool held = IsKeyDown(KEY_ENTER);
+            for (int button = 1; padOk && button <= GAMEPAD_BUTTON_RIGHT_THUMB; ++button)
+                held = held || IsGamepadButtonDown(m.pad, button);
+            while (GetKeyPressed() != 0)
+                ;
+            m.captureArmed = !held;
+            return;
+        }
+        int button = 0, key = 0;
+        for (int i = 1; padOk && i <= GAMEPAD_BUTTON_RIGHT_THUMB && button == 0; ++i)
+            if (IsGamepadButtonPressed(m.pad, i))
+                button = i;
+        for (int k = GetKeyPressed(); k != 0; k = GetKeyPressed())
+            if (k != KEY_F1 && (k < KEY_F9 || k > KEY_F12) && (m.pad == 0 || k == KEY_BACKSPACE)) // teclado: só jogador 1
+                key = key ? key : k;
+        if (key == KEY_BACKSPACE)
+        {
+            m.capture = -1;
+            return;
+        }
+        if (button != 0)
+        {
+            for (int i = 0; i < kPadBindingCount; ++i)
+                if (&bindings[i] != &b && bindings[i].gamepad == button)
+                    bindings[i].gamepad = b.gamepad;
+            b.gamepad = button;
+        }
+        else if (key != 0)
+        {
+            for (int i = 0; i < kPadBindingCount; ++i)
+            {
+                if (&bindings[i] == &b)
+                    continue;
+                if (bindings[i].key == key)
+                    bindings[i].key = b.key;
+                if (bindings[i].key2 == key)
+                    bindings[i].key2 = 0;
+            }
+            b.key = key, b.key2 = 0;
+        }
+        else
+            return;
+        m.capture = -1;
+        m.saveTried = true;
+        m.saved = saveGfx();
+    }
