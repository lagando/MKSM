+
+# The GPU rasterizer repeats the CPU float math operation by operation; letting GCC fuse
+# a*b+c into FMA on its own (the default with -march=native) would make the two differ.
+set_source_files_properties(src/lib/gs/gs_cpu_backend.cpp PROPERTIES COMPILE_OPTIONS "-ffp-contract=off")
+
+# GS on the GPU (PS2X_GS_GPU=1 at run time): Vulkan compute. Headers come from Khronos;
+# the loader (libvulkan) and glslc come from the system. Without them the CPU path stays.
+option(PS2X_ENABLE_GS_GPU "Build the Vulkan GS accelerator" ON)
+find_library(PS2X_VULKAN_LIBRARY NAMES vulkan vulkan-1)
+find_program(PS2X_GLSLC glslc)
+if(PS2X_ENABLE_GS_GPU AND PS2X_VULKAN_LIBRARY AND PS2X_GLSLC)
+    include(FetchContent)
+    FetchContent_Declare(
+        vulkan_headers
+        GIT_REPOSITORY https://github.com/KhronosGroup/Vulkan-Headers.git
+        GIT_TAG v1.3.299
+        GIT_SHALLOW TRUE
+    )
+    FetchContent_MakeAvailable(vulkan_headers)
+
+    set(PS2X_GS_SHADER_DIR ${CMAKE_CURRENT_BINARY_DIR}/gs_shaders)
+    foreach(shader gs_sprite gs_tiles)
+        set(shader_out ${PS2X_GS_SHADER_DIR}/${shader}.inc)
+        add_custom_command(
+            OUTPUT ${shader_out}
+            COMMAND ${CMAKE_COMMAND} -E make_directory ${PS2X_GS_SHADER_DIR}
+            COMMAND ${PS2X_GLSLC} -O -mfmt=num -fshader-stage=compute
+                    ${CMAKE_CURRENT_SOURCE_DIR}/src/lib/gs/shaders/${shader}.comp -o ${shader_out}
+            DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/src/lib/gs/shaders/${shader}.comp
+            COMMENT "Compiling GS shader ${shader}"
+        )
+        target_sources(ps2_runtime PRIVATE ${shader_out})
+    endforeach()
+    target_include_directories(ps2_runtime PRIVATE ${PS2X_GS_SHADER_DIR})
+    target_compile_definitions(ps2_runtime PRIVATE PS2X_HAVE_VULKAN=1)
+    target_link_libraries(ps2_runtime PRIVATE Vulkan::Headers ${PS2X_VULKAN_LIBRARY})
+    message(STATUS "GS GPU accelerator: Vulkan (${PS2X_VULKAN_LIBRARY})")
+else()
+    message(STATUS "GS GPU accelerator: off (needs libvulkan and glslc)")
+endif()
 target_link_libraries(ps2EntryRunner
     PRIVATE
     ps2_runtime
