+namespace
+{
+    // A tela de dificuldade, estável: some por um quadro ou outro na RAM, então só conta como fechada depois de meio
+    // segundo sem ser vista (o cursor fica no último valor lido). Antes, um L3 nesse quadro se perdia.
+    struct { bool open = false, hard = false; double seen = -10.0; } g_diff;
+
+    // Modo RPG na tela de dificuldade de um jogo novo: com o cursor no Hard, L3 (F2 no teclado) liga e desliga.
+    void updateRpgDifficulty(const uint8_t *rdram)
+    {
+        if (bool hard = false; mksm_rpg::difficultyScreen(rdram, hard))
+            g_diff.seen = GetTime(), g_diff.hard = hard;
+        uint32_t loaded = 0; // 0x50BC14 = 1: a partida começou a carregar; o painel some na hora, sem esperar a folga
+        std::memcpy(&loaded, rdram + 0x50BC14u, 4u);
+        g_diff.open = GetTime() - g_diff.seen < 0.5 && loaded == 0u;
+        const bool open = g_diff.open, hard = g_diff.hard;
+        static bool wasOpen = false;
+        if (open && !wasOpen) // cada jogo novo começa sem RPG e com os lutadores da seleção
+            mksm_rpg::setArmed(false), mksm_rpg::setFighterPick(0, -1), mksm_rpg::setFighterPick(1, -1);
+        wasOpen = open;
+        if (!open || g_gfxMenu.open)
+            return;
+        static const bool autoArm = std::getenv("MKSM_RPG_AUTO_ARM") != nullptr; // roteiro de teste: arma no Hard
+        if (!hard)
+            mksm_rpg::setArmed(false); // o RPG é uma variante do Hard
+        else if (autoArm)
+            mksm_rpg::setArmed(true);
+        else if (IsKeyPressed(KEY_F2) || boundPressed(0, "L3"))
+            mksm_rpg::setArmed(!mksm_rpg::armed());
+        if (const char *test = std::getenv("MKSM_TEST_LUTADOR")) // roteiro de teste: "90" ou "88,83" (jogador 1, jogador 2)
+        {
+            char *end = nullptr;
+            mksm_rpg::setFighterPick(0, static_cast<int>(std::strtol(test, &end, 10)));
+            if (end && *end == ',')
+                mksm_rpg::setFighterPick(1, static_cast<int>(std::strtol(end + 1, nullptr, 10)));
+        }
+        // Lutador do jogo novo: L2/R2 no controle de cada jogador (Shift esq./dir. no teclado, jogador 1; L1/R1 trocam
+        // as abas da janela R3). -1 = o escolhido na seleção.
+        static int heldDir[2] = {};
+        static double nextStep[2] = {};
+        for (int j = 0; j < 2; ++j)
+        {
+            // L2/R2 como o jogador mapeou na aba Controles (Shift esq./dir. continuam valendo no teclado)
+            const int want = boundDown(j, "R2") || (j == 0 && IsKeyDown(KEY_RIGHT_SHIFT)) ? 1
+                           : boundDown(j, "L2") || (j == 0 && IsKeyDown(KEY_LEFT_SHIFT)) ? -1 : 0;
+            // um passo ao apertar; segurado, passa sozinho depois de 0,4 s (a lista tem ~60 nomes)
+            int dir = 0;
+            if (want != heldDir[j])
+                dir = want, heldDir[j] = want, nextStep[j] = GetTime() + 0.4;
+            else if (want != 0 && GetTime() >= nextStep[j])
+                dir = want, nextStep[j] = GetTime() + 0.09;
+            if (dir == 0)
+                continue;
+            constexpr int n = static_cast<int>(std::size(kFighters)) + 1; // posição 0 = o escolhido no jogo
+            const int now = mksm_rpg::fighterPick(j);
+            int at = 0;
+            for (int i = 1; i < n; ++i)
+                if (kFighters[i - 1].id == now)
+                    at = i;
+            at = (at + n + dir) % n;
+            mksm_rpg::setFighterPick(j, at == 0 ? -1 : kFighters[at - 1].id);
+        }
+    }
+
+    // Por cima da imagem do jogo (posições em fração dela, certas em 4:3 e 16:9): marca na tela de
+    // dificuldade, nível ao lado do nome do personagem e o aviso de nível novo.
+    void drawRpgOverlay(const Rectangle &area, const uint8_t *rdram, bool inPlay, bool inGameMenu, bool gameDrawing, bool gameAlive)
+    {
+        if (g_gfxMenu.open) // a janela R3 fica por cima de tudo
+            return;
+        if (inPlay && !inGameMenu && g_p2BlockLatch.load(std::memory_order_relaxed))
+        {
+            const float size = std::max(10.0f, area.height / 36.0f);
+            const char *note = "J2 defendendo (cima no controle 2 desliga)";
+            const Color c{236, 224, 44, 255};
+            hudText(note, area.x + area.width - hudText(note, 0, 0, size, c, false) - size, area.y + area.height * 0.93f, size, c);
+        }
+        const Color gold{214, 170, 84, 255}, dim{190, 160, 110, 255};
+        const int font = static_cast<int>(std::max(12.0f, area.height / 30.0f));
+        const auto at = [&area](float fx, float fy) { return Vector2{area.x + area.width * fx, area.y + area.height * fy}; };
+        if (mksm_rpg::loadScreen(rdram) && gameDrawing && !g_gfxMenu.open) // tag em cima de cada slot RPG
+        {
+            for (int k = 0; k < mksm_rpg::kSlots; ++k)
+                if (int level = 0; mksm_rpg::slotIsRpg(0, k, level))
+                {
+                    char tag[32];
+                    std::snprintf(tag, sizeof(tag), "RPG · Nível %d", level);
+                    const float size = std::max(10.0f, font * 0.62f);
+                    const Vector2 p = at(0.168f, 0.330f + 0.058f * k - 0.031f); // logo acima do nome do slot
+                    hudText(tag, p.x, p.y - size / 2, size, gold);
+                }
+            return;
+        }
+        if (g_diff.open)
+        {
+            const Color yellow{236, 214, 52, 255}, cream{236, 230, 214, 255}, muted{150, 140, 120, 255};
+            if (g_diff.hard) // à direita da palavra HARD
+            {
+                const Vector2 p = at(0.565f, 0.488f);
+                if (mksm_rpg::armed())
+                    smallCaps("RPG", p.x, p.y - font * 0.35f, font * 1.5f, yellow);
+                else
+                    smallCaps(IsGamepadAvailable(0) ? "L3: Modo RPG" : "F2: Modo RPG", p.x, p.y - font * 0.1f, font * 0.95f, muted);
+            }
+            // Embaixo do quadro do jogo: o lutador de cada jogador (L2/R2 no controle dele; o 2 só com dois controles).
+            const bool second = IsGamepadAvailable(1) || mksm_rpg::fighterPick(1) >= 0;
+            const float rowH = font * 2.35f, title = font * 1.05f;
+            const Rectangle panel{area.x + area.width * 0.22f, area.y + area.height * 0.708f, area.width * 0.56f,
+                                  title + font * 1.0f + rowH * (second ? 2.0f : 1.0f)};
+            drawGamePanel(panel);
+            const float cx = panel.x + panel.width / 2;
+            smallCapsCentered(second ? "Lutadores" : "Lutador", cx, panel.y + font * 0.45f, title, yellow);
+            for (int j = 0; j < (second ? 2 : 1); ++j)
+            {
+                const int id = mksm_rpg::fighterPick(j);
+                const Fighter *f = findFighter(id);
+                const float y = panel.y + font * 0.65f + title + rowH * j, size = font * 1.3f;
+                smallCapsCentered(f ? f->name : "Da seleção", cx, y, size, f ? cream : muted);
+                if (f && f->tag)
+                    smallCapsCentered(f->tag, cx, y + size * 0.98f, font * 0.8f, Color{214, 140, 84, 255});
+                if (second)
+                    smallCaps(j == 0 ? "J1" : "J2", panel.x + font * 0.7f, y + size * 0.12f, font * 0.92f, muted);
+                // setas com o botão, dos dois lados do nome
+                const bool pad = IsGamepadAvailable(j);
+                const float ay = y + size * 0.5f, ax = panel.width * 0.345f, tri = font * 0.48f, hint = font * 0.92f;
+                DrawTriangle(Vector2{cx - ax - tri, ay}, Vector2{cx - ax, ay + tri}, Vector2{cx - ax, ay - tri}, yellow);
+                DrawTriangle(Vector2{cx + ax + tri, ay}, Vector2{cx + ax, ay - tri}, Vector2{cx + ax, ay + tri}, yellow);
