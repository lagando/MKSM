+bool GSCpuBackend::PrepareGpuSprite(const GSPrimitiveBatch &batch, bool feedback, GSGpuSpriteJob &job) const
+{
+    const GSDrawState &state = batch.state;
+    const auto &ctx = state.context;
+    if (state.prim.type != GS_PRIM_SPRITE)
+        return false;
+    const uint64_t testReg = ctx.test;
+    const bool simplePixels = ctx.frame.psm == GS_PSM_CT32 && ctx.frame.fbmsk == 0u && !state.prim.fge &&
+                              (testReg & 1u) == 0u && ((testReg >> 14) & 1u) == 0u && ((testReg >> 17) & 3u) == 1u &&
+                              ctx.zbuf.zmask && (ctx.fba & 1ull) == 0ull && !state.pabe;
+    const bool simpleTexture = !state.prim.tme ||
+                               (state.prim.fst && !state.linearFilter && ctx.tex0.psm == GS_PSM_CT32 && ctx.tex0.tfx == 1u);
+    if (!simplePixels || !simpleTexture)
+        return false;
+
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const int ofx = ctx.xyoffset.ofx >> 4;
+    const int ofy = ctx.xyoffset.ofy >> 4;
+    int x0 = static_cast<int>(v0.x) - ofx;
+    int y0 = static_cast<int>(v0.y) - ofy;
+    int x1 = static_cast<int>(v1.x) - ofx;
+    int y1 = static_cast<int>(v1.y) - ofy;
+    if (x0 > x1)
+        std::swap(x0, x1);
+    if (y0 > y1)
+        std::swap(y0, y1);
+    const int unclippedX0 = x0, unclippedY0 = y0;
+    const int spanX = std::max(1, x1 - x0), spanY = std::max(1, y1 - y0);
