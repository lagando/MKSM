+    bool presetHigh(const GfxSettings &g) { return g.newRenderer && g.scale == 2u && g.fxaa == kRecFxaa && g.bicubic && g.effects; }
+    bool presetLow(const GfxSettings &g) { return g.newRenderer && g.scale == 1u && !g.fxaa && !g.bicubic && g.effects; }
+    // For weak video cards: also simple glow (~12-16% less GS time at 1x) and no field blending.
+    bool presetMin(const GfxSettings &g) { return g.newRenderer && g.scale == 1u && !g.fxaa && !g.bicubic && !g.effects && !g.blend; }
+    int presetIndex(const GfxSettings &g) { return presetHigh(g) ? 0 : presetLow(g) ? 1 : presetMin(g) ? 2 : -1; }
+
+    void applyScale(uint32_t scale)
+    {
+        if (GSHwBackend *hw = GSHwBackend::Active())
+            hw->SetScale(scale), gfx().scale = hw->Scale();
+        else
+            gfx().scale = scale; // the old renderer runs: kept for the new one
+    }
+
+    // Sincronia vertical: a troca do buffer espera o monitor (o raylib chama glfwSwapInterval). Sem ela, a janela anda pelo
+    // próprio relógio de 60 Hz, que se desencontra do monitor aos poucos (um quadro repete, o seguinte some). Com ela, o
+    // teto de 240/s só evita girar à toa se o driver ignorar o pedido; a fila em ordem mostra cada quadro do jogo uma vez.
+    void applyVsync(bool on)
+    {
+        if (on)
+            SetWindowState(FLAG_VSYNC_HINT), SetTargetFPS(240);
+        else
+            ClearWindowState(FLAG_VSYNC_HINT), SetTargetFPS(60);
+    }
+
+    void changeGfxRow(int row, int dir)
+    {
+        GfxSettings &g = gfx();
+        switch (row)
+        {
+        case RowPreset: // Alto -> Leve -> Mínimo -> Alto (left goes back)
+        {
+            const int now = presetIndex(g), next = now < 0 ? (dir < 0 ? 2 : 0) : (now + (dir < 0 ? 2 : 1)) % 3;
+            applyScale(next == 0 ? 2u : 1u);
+            g.fxaa = next == 0 && kRecFxaa;
+            g.bicubic = next == 0;
+            g.effects = next != 2;
+            g.blend = next != 2 && kRecBlend;
+            g.newRenderer = true;
+            break;
+        }
+        case RowScale: applyScale(((g.scale - 1u + (dir < 0 ? 3u : 1u)) % 4u) + 1u); break;
+        case RowWide: g.widescreen = !g.widescreen; break;
+        case RowFxaa: g.fxaa = !g.fxaa; break;
+        case RowFilter: g.bicubic = !g.bicubic; break;
+        case RowBlend: g.blend = !g.blend; break;
+        case RowVsync:
+            g.vsync = !g.vsync;
+            applyVsync(g.vsync);
+            break;
+        case RowEffects: g.effects = !g.effects; break;
+        case RowBloom: g.bloom = !g.bloom; break;
+        case RowRenderer: g.newRenderer = !g.newRenderer; break;
+        case RowThread: g.thread = !g.thread; break;
+        case RowReset: // what a fresh install runs with (main.cpp defaults and GfxSettings)
+            applyScale(2u);
+            g.bicubic = g.newRenderer = g.effects = true;
+            g.fxaa = kRecFxaa, g.blend = kRecBlend;
+            if (g.vsync)
+                g.vsync = false, applyVsync(false);
+            g.widescreen = false;
+            g.bloom = false;
+            g.thread = std::thread::hardware_concurrency() >= 4u;
+            break;
+        default: return;
+        }
+        g_gsEffects.store(g.effects, std::memory_order_relaxed);
+        g_gfxMenu.saveTried = true;
+        g_gfxMenu.saved = saveGfx();
+    }
