+    if (m_queue.size() >= kMaxQueuedCommands)
+    {
+        const uint64_t waitStart = ps2_perf::enabled() ? ps2_perf::nowNs() : 0u;
+        m_queueCv.wait(lock, [this]
+                       { return m_queue.size() < kMaxQueuedCommands; });
+        if (ps2_perf::enabled())
+            ps2_perf::counters().eeWaitingGsNs.fetch_add(ps2_perf::nowNs() - waitStart, std::memory_order_relaxed);
+    }
+    m_queue.push_back(std::move(command));
+    if (m_queue.size() == 1u)
+        m_queueCv.notify_all();
