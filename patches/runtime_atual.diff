+    x = _mm_blendv_epi8(x, _mm_and_si128(x, _mm_set1_epi32(static_cast<int>(0x80000000u))), den);
+    return _mm_xor_si128(x, _mm_srli_epi32(_mm_srai_epi32(x, 31), 1));
