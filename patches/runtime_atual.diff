+    void drawGfxMenu(const Rectangle &area, bool hint)
+    {
+        const GfxSettings &g = gfx();
+        const GfxMenu &m = g_gfxMenu;
+        const int font = static_cast<int>(std::max(12.0f, area.height / 30.0f));
+        const Color gold{214, 170, 84, 255}, text{230, 225, 210, 255}, dim{150, 145, 135, 255};
+        const mksm_rpg::Snapshot rpg = mksm_rpg::snapshot(m.rpgPlayer);
+        if (!m.open)
+        {
+            if (hint)
+            {
+                const int freeAll = rpg.active ? mksm_rpg::snapshot(0).freePoints + (rpg.coop ? mksm_rpg::snapshot(1).freePoints : 0) : 0;
+                char rpgLabel[32];
+                std::snprintf(rpgLabel, sizeof(rpgLabel), "R3: RPG +%d", freeAll);
+                const char *label = !rpg.active ? "R3: Gráfico" : freeAll > 0 ? rpgLabel : "R3: Gráfico · RPG";
+                const float size = font * 1.1f;
+                smallCaps(label, area.x + area.width - smallCaps(label, 0, 0, size, gold, false) - font, area.y + area.height - font * 2.2f, size, gold);
+            }
+            return;
+        }
+        // The Controles tab has more rows: a smaller font keeps the panel inside the picture.
+        const int rowCount = m.tab == TabGfx ? static_cast<int>(RowCount) : m.tab == TabCtl ? static_cast<int>(CtlRowCount) : static_cast<int>(RpgRowCount);
+        const int rowFont = m.tab != TabCtl ? font : static_cast<int>(std::max(11.0f, area.height / 42.0f));
+        const float line = rowFont * 1.55f;
+        const float width = std::min(area.width * 0.92f, font * 32.0f), height = line * (rowCount + (m.tab == TabRpg ? 2.5f : 0.0f)) + font * (m.tab == TabCtl ? 7.5f : 6.5f);
+        const Rectangle panel{area.x + (area.width - width) * 0.5f, area.y + (area.height - height) * 0.5f, width, height};
+        DrawRectangle(0, 0, GetScreenWidth(), GetScreenHeight(), Color{0, 0, 0, 120});
+        DrawRectangleRec(panel, Color{10, 12, 16, 235});
+        DrawRectangleLinesEx(panel, 2.0f, gold);
+        const int left = static_cast<int>(panel.x + font), right = static_cast<int>(panel.x + panel.width - font);
+        const int small = std::max(10, font * 3 / 4);
+        int y = static_cast<int>(panel.y + font * 0.8f);
+        const char *tabs[TabCount] = {"Gráfico", "Controles", "RPG"};
+        for (int t = 0, x = left; t < (rpg.active ? static_cast<int>(TabCount) : static_cast<int>(TabRpg)); ++t)
+        {
+            DrawText(tabs[t], x, y, font + font / 4, t == m.tab ? gold : dim);
+            x += MeasureText(tabs[t], font + font / 4) + font * 3 / 2;
+        }
+        DrawText("L1/R1: aba", right - MeasureText("L1/R1: aba", small), y + font / 2, small, dim);
+        y += static_cast<int>(font * 2.1f);
+        const auto drawRow = [&](int row, const char *label, const std::string &value, bool enabled = true)
+        {
+            const bool selected = row == m.row;
+            if (selected)
+                DrawRectangle(left - font / 2, y - rowFont / 4, right - left + font, static_cast<int>(line) - rowFont / 4, Color{70, 52, 22, 230});
+            const Color color = !enabled ? dim : selected ? gold : text;
+            DrawText(label, left, y, rowFont, color);
+            if (!value.empty())
+                DrawText(value.c_str(), right - MeasureText(value.c_str(), rowFont), y, rowFont, color);
+            y += static_cast<int>(line);
+        };
+        if (m.tab == TabRpg)
+        {
+            char header[96], progress[96];
+            if (!rpg.active)
+            {
+                DrawText("Este save não é do modo RPG.", left, y, rowFont, text);
+                y += static_cast<int>(line);
+                DrawText("Para jogar nele, comece um jogo novo e aperte L3 (F2) no Hard.", left, y, small, dim);
+                y += static_cast<int>(line * 1.5f);
+                y += static_cast<int>(line * mksm_rpg::AttrCount + line);
+                drawRow(RpgClose, "Fechar", "");
+            }
+            else
+            {
+                std::snprintf(header, sizeof(header), "%sNível %d   ·   %d ponto%s livre%s", rpg.coop ? (m.rpgPlayer == 0 ? "Jogador 1   ·   " : "Jogador 2   ·   ") : "",
+                              rpg.level, rpg.freePoints, rpg.freePoints == 1 ? "" : "s", rpg.freePoints == 1 ? "" : "s");
+                DrawText(header, left, y, rowFont, gold);
+                y += static_cast<int>(line);
+                if (rpg.xpStep > 0)
+                    std::snprintf(progress, sizeof(progress), "Próximo nível  %lld / %lld", static_cast<long long>(rpg.xpInLevel), static_cast<long long>(rpg.xpStep));
+                else
+                    std::snprintf(progress, sizeof(progress), "Nível máximo");
+                DrawText(progress, left, y, small, text);
+                const int barX = left + MeasureText("Próximo nível  0000000 / 0000000", small) + font / 2, barW = right - barX;
+                if (barW > font * 3)
+                {
+                    const float fill = rpg.xpStep > 0 ? static_cast<float>(rpg.xpInLevel) / static_cast<float>(rpg.xpStep) : 1.0f;
+                    DrawRectangle(barX, y + small / 6, barW, small * 2 / 3, Color{40, 36, 30, 255});
+                    DrawRectangle(barX, y + small / 6, static_cast<int>(barW * std::clamp(fill, 0.0f, 1.0f)), small * 2 / 3, gold);
+                }
+                y += static_cast<int>(line * 1.5f);
+                for (int a = 0; a < mksm_rpg::AttrCount; ++a)
+                {
+                    const bool canSpend = rpg.freePoints > 0 && (rpg.caps[a] == 0 || rpg.points[a] < rpg.caps[a]);
+                    const int rowY = y;
+                    drawRow(a, mksm_rpg::attrName(a), mksm_rpg::attrEffect(a, rpg.points[a]), canSpend || rpg.points[a] > 0);
+                    const std::string count = std::to_string(rpg.points[a]); // coluna fixa: a fonte é proporcional
+                    DrawText(count.c_str(), left + rowFont * 9 - MeasureText(count.c_str(), rowFont), rowY, rowFont,
+                             a == m.row ? gold : (canSpend || rpg.points[a] > 0) ? text : dim);
+                }
+                drawRow(RpgReset, m.confirmReset ? "Redistribuir pontos: X de novo para confirmar" : "Redistribuir pontos", "");
+                drawRow(RpgClose, "Fechar", "");
+            }
+        }
+        else if (m.tab == TabGfx)
+        {
+            const auto onOff = [](bool on) { return on ? "Ligada" : "Desligada"; };
+            char scaleText[48];
+            std::snprintf(scaleText, sizeof(scaleText), GSHwBackend::Active() ? "%ux" : "%ux (renderizador novo)", g.scale);
+            const char *rows[RowCount][2] = {
+                {"Predefinição", presetHigh(g) ? "Alto" : presetLow(g) ? "Leve" : presetMin(g) ? "Mínimo" : "Personalizado"},
+                {"Resolução interna", scaleText},
+                {"Tela", g.widescreen ? "16:9" : "4:3"},
+                {"Suavização (FXAA)", onOff(g.fxaa)},
+                {"Filtro de ampliação", g.bicubic ? "Bicúbico" : "Bilinear"},
+                {"Mistura de campos", onOff(g.blend)},
+                {"Sincronia vertical", onOff(g.vsync)},
+                {"Efeitos de luz", g.effects ? "Completos" : "Simples"},
+                {"Brilho (bloom)", onOff(g.bloom)},
+                {"Renderizador", g.newRenderer != g.runningNew ? (g.newRenderer ? "Novo *" : "Antigo *") : (g.newRenderer ? "Novo" : "Antigo")},
+                {"Thread de desenho", g.thread != g.runningThread ? (g.thread ? "Ligada *" : "Desligada *") : onOff(g.thread)},
+                {"Restaurar recomendado", ""},
+                {"Fechar", ""}};
+            for (int row = 0; row < RowCount; ++row)
+                drawRow(row, rows[row][0], rows[row][1][0] ? std::string("< ") + rows[row][1] + " >" : std::string());
+        }
+        else
+        {
+            const PadBinding *b = padBindings(m.pad);
+            for (int row = 0; row < kPadBindingCount; ++row)
+            {
+                std::string keys = b[row].key ? keyName(b[row].key) : std::string("-");
+                if (b[row].key2)
+                    keys += " / " + keyName(b[row].key2);
+                const std::string waiting = m.pad == 0 ? "Aperte um botão ou tecla (Backspace cancela)" : "Aperte um botão do controle 2 (Backspace cancela)";
+                drawRow(row, b[row].name, row == m.capture ? waiting
+                                                           : m.pad == 0 ? std::string(gamepadButtonName(b[row].gamepad)) + "   ·   " + keys
+                                                                        : std::string(gamepadButtonName(b[row].gamepad)));
+            }
+            drawRow(CtlReset, "Restaurar padrão", "");
+            drawRow(CtlClose, "Fechar", "");
+        }
+        y += static_cast<int>(line * 0.3f);
+        if (m.tab == TabRpg)
+        {
+            char capLine[96];
+            if (rpg.cap)
+                std::snprintf(capLine, sizeof(capLine), "Cada nível dá pontos. Teto: %d por atributo, %d na Sabedoria", rpg.cap, rpg.caps[mksm_rpg::Sabedoria]);
+            else
+                std::snprintf(capLine, sizeof(capLine), "Cada nível dá pontos.");
+            DrawText(capLine, left, y, small, dim);
+            y += static_cast<int>(small * 1.5f);
+            DrawText(rpg.coop ? "Cima/Baixo: escolher   X: gastar ponto   O ou R3: fechar   (o outro jogador: R3 no controle dele)"
+                              : "Cima/Baixo: escolher   X: gastar ponto   O ou R3: fechar", left, y, small, dim);
+            return;
+        }
+        if (m.tab == TabGfx)
+        {
+            DrawText("* vale ao reiniciar o jogo", left, y, small, dim);
+            y += static_cast<int>(small * 1.5f);
+            DrawText("Cima/Baixo: escolher   Esquerda/Direita ou X: mudar   O ou R3: fechar", left, y, small, dim);
+        }
+        else
+        {
+            DrawText(m.pad == 0 ? "Jogador 1: controle   ·   teclado." : "Jogador 2: botões do controle 2.", left, y, small, dim);
+            y += static_cast<int>(small * 1.5f);
+            DrawText(m.pad == 0 ? "Jogador 2: abra a janela com o R3 do controle 2." : "Controle 2, cima: liga/desliga a defesa contínua.",
+                     left, y, small, dim);
+            y += static_cast<int>(small * 1.5f);
+            DrawText("Cima/Baixo: escolher   X: trocar o botão   O ou R3: fechar", left, y, small, dim);
+        }
+        y += static_cast<int>(small * 1.5f);
+        if (m.saveTried)
+            DrawText(m.saved ? "Salvo no mksm.ini" : "Não salvo: abra o jogo pelo jogar.sh", left, y, small, m.saved ? dim : gold);
+    }
