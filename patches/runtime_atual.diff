+    // Fonte serifada do sistema para o que desenhamos nas telas do jogo, que usa letras serifadas em versalete;
+    // sem nenhuma destas, fica a fonte do raylib. Carrega no primeiro uso (precisa do contexto GL).
+    const Font &overlayFont()
+    {
+        static const Font font = [] {
+            const char *paths[] = {"C:/Windows/Fonts/palab.ttf", "C:/Windows/Fonts/georgiab.ttf", "C:/Windows/Fonts/timesbd.ttf",
+                                   "/usr/share/fonts/noto/NotoSerifDisplay-Bold.ttf", "/usr/share/fonts/noto/NotoSerif-Bold.ttf",
+                                   "/usr/share/fonts/truetype/noto/NotoSerif-Bold.ttf", "/usr/share/fonts/liberation/LiberationSerif-Bold.ttf",
+                                   "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf", "/usr/share/fonts/TTF/DejaVuSerif-Bold.ttf",
+                                   "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf"};
+            int codepoints[191];
+            for (int i = 0; i < 191; ++i)
+                codepoints[i] = i < 95 ? 32 + i : 160 + (i - 95); // ASCII e Latin-1 (acentos)
+            for (const char *path : paths)
+                if (FileExists(path))
+                    if (Font f = LoadFontEx(path, 64, codepoints, 191); f.texture.id != 0)
+                    {
+                        GenTextureMipmaps(&f.texture);
+                        SetTextureFilter(f.texture, TEXTURE_FILTER_TRILINEAR);
+                        return f;
+                    }
+            return GetFontDefault();
+        }();
+        return font;
+    }
