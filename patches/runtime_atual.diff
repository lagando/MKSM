+                {makeVuLowerDirect(0x32u, 1u, 5u, 31u), makeVuUpper(0x22u, 0xFu, 0u, 2u, 20u)},     // IADDI / ADDi
+                {isub, makeVuUpper(0x29u, 0xFu, 22u, 22u, 23u)},                                    // ISUBIU / MADD at MAX
+                {makeVuLowerSpecial(0x36u, 1u, 24u, 0u, 0xFu), makeVuUpper(0x2Du, 0xFu, 22u, 22u, 25u)}, // LQD / MSUB at MAX
+                {makeVuLowerSpecial(0x37u, 6u, 1u, 0u, 0x5u), makeVuUpper(0x2Au, 0xFu, 20u, 2u, 21u)}};  // SQD / MUL
+            compare(covered, "operation coverage");
+
+            // An interpreted VI write (the M bit keeps a pair out of the recompiler) leaves the
+            // branch backup set; the block after it must drop it, or the interpreted IBNE
+            // past the block reads the old vi3 and falls through.
+            constexpr uint32_t mBit = 0x20000000u;
+            const uint32_t ibne = (0x29u << 25) | (3u << 16) | (0u << 11) | 2u; // IBNE vi3, vi0, +2
+            Program backup;
+            backup.pairs = {{makeVuIaddiu(3u, 0u, 5), kVuUpperNop | mBit},
+                            {kVuLowerNop, kVuUpperNop},
+                            {kVuLowerNop, kVuUpperNop},
+                            {ibne, kVuUpperNop | mBit},
+                            {kVuLowerNop, kVuUpperNop},
+                            {makeVuIaddiu(5u, 0u, 1), kVuUpperNop},
+                            {makeVuIaddiu(6u, 0u, 1), kVuUpperNop}};
+            compare(backup, "VI branch backup across a block");
+
+            // MAX/MINI order operands as sign-magnitude integers: +0 > -0; denormals are zero.
+            Program signedZeros;
+            signedZeros.vf = {{2u, {0x00000000u, 0x80000000u, 0x00000001u, bits(-1.0f)}},
+                              {3u, {0x80000000u, 0x00000000u, 0x80000001u, bits(-2.0f)}}};
+            signedZeros.pairs = {{kVuLowerNop, makeVuUpper(0x2Bu, 0xFu, 3u, 2u, 4u)},  // MAX vf4, vf2, vf3
+                                 {kVuLowerNop, makeVuUpper(0x2Fu, 0xFu, 3u, 2u, 5u)},  // MINI vf5, vf2, vf3
+                                 {kVuLowerNop, kVuUpperNop}};
+            compare(signedZeros, "MAX/MINI signed zeros");
+            const Outcome zeros = run(signedZeros, false);
+            const std::array<uint32_t, 4> maxWanted = {0x00000000u, 0x00000000u, 0x00000000u, bits(-1.0f)};
+            const std::array<uint32_t, 4> minWanted = {0x80000000u, 0x80000000u, 0x80000000u, bits(-2.0f)};
+            t.IsTrue(std::memcmp(zeros.state.vf[4], maxWanted.data(), 16u) == 0, "MAX: +0 beats -0, denormals as signed zero");
+            t.IsTrue(std::memcmp(zeros.state.vf[5], minWanted.data(), 16u) == 0, "MINI: -0 beats +0, denormals as signed zero");
+        });
+
+        // An XGKICK ends its recompiled block and waits there for the previous PATH1
+        // transfer; the ADD in its pair then issues that much later, and the next ADD stalls on it.
+        tc.Run("recompiled XGKICK waits for the previous transfer like the interpreter", [](TestCase &t)
+        {
+            const auto run = [&t](bool jit)
+            {
+                Vu1Fixture fx;
+                t.IsTrue(fx.initialize(), "VU1 fixture should initialize");
+                const uint32_t xgkickVi1 = 0x80000EFCu;
+                const std::vector<std::pair<uint32_t, uint32_t>> pairs = {
+                    {makeVuIaddiu(1u, 0u, 48), kVuUpperNop},
+                    {makeVuSq(0xFu, 20u, 1u, 0), kVuUpperNop}, // GIFtag: 4 PACKED NOP qwords, EOP
+                    {kVuLowerNop, kVuUpperNop},
+                    {kVuLowerNop, kVuUpperNop},
+                    {xgkickVi1, kVuUpperNop},
+                    {kVuLowerNop, kVuUpperNop},
+                    {xgkickVi1, makeVuUpper(0x28u, 0xFu, 3u, 2u, 21u)}, // XGKICK / ADD vf21
+                    {kVuLowerNop, makeVuUpper(0x28u, 0xFu, 21u, 21u, 22u)},
+                    {kVuLowerNop, kVuUpperNop},
+                    {kVuLowerNop, kVuUpperNop},
+                    {kVuLowerNop, kVuUpperNop},
+                    {kVuLowerNop, kVuUpperNop}};
+                uint32_t pc = 0u;
+                for (const auto &[lower, upper] : pairs)
+                {
+                    writeVuInstructionPair(fx.code, pc, lower, upper);
+                    pc += 8u;
+                }
+                writeVuInstructionPair(fx.code, pc, 0u, kVuUpperNop | 0x40000000u);
+                writeVuInstructionPair(fx.code, pc + 8u, 0u, kVuUpperNop);
+                VU1Interpreter vu1;
+                vu1.setJitEnabled(jit);
+                const uint32_t tag[4] = {0x00008004u, 0x10000000u, 0xFu, 0u};
+                std::memcpy(vu1.state().vf[20], tag, 16u);
+                const float two[4] = {2.0f, 2.0f, 2.0f, 2.0f}, three[4] = {3.0f, 3.0f, 3.0f, 3.0f};
+                std::memcpy(vu1.state().vf[2], two, 16u);
+                std::memcpy(vu1.state().vf[3], three, 16u);
+                vu1.execute(fx.code, PS2_VU1_CODE_SIZE, fx.data, PS2_VU1_DATA_SIZE, fx.gs, &fx.mem, 0u, 0u, 0u, 4096u);
+                return vu1.state();
+            };
+            const VU1State interpreted = run(false);
+            const VU1State recompiled = run(true);
+            t.Equals(recompiled.cycles, interpreted.cycles, "the stall and the ADD after it should take the same cycles");
+            t.IsTrue(std::memcmp(interpreted.vf[22], recompiled.vf[22], 16u) == 0, "vf22 should match");
+            t.Equals(interpreted.vf[22][0], 10.0f, "vf22 should be (2+3)*2");
+        });
     });
 }
