+    // Test harness: MKSM_GFX_SCRIPT="188o,190d,191l,194c" presses o(pen/R3) u d l r x c(lose) at those seconds.
+    char gfxScriptStep()
+    {
+        static const char *script = std::getenv("MKSM_GFX_SCRIPT");
+        static const char *next = script;
+        if (!next || !*next || GetTime() < std::atof(next))
+            return 0;
+        while (*next && (std::isdigit(static_cast<unsigned char>(*next)) || *next == '.'))
+            ++next;
+        const char step = *next ? *next++ : 0;
+        if (*next == ',')
+            ++next;
+        return step;
+    }
+
+    // Botão do controle (e teclas, jogador 1) que o jogador mapeou para um botão do PS2 na aba Controles: as telas do
+    // runtime (R3 abre a janela, L3 arma o RPG, L2/R2 trocam o lutador) seguem o mesmo mapa que o jogo.
+    const PadBinding *boundTo(int pad, const char *ps2Name)
+    {
+        PadBinding *b = padBindings(pad);
+        for (int i = 0; i < kPadBindingCount; ++i)
+            if (std::strcmp(b[i].iniName, ps2Name) == 0)
+                return &b[i];
+        return nullptr;
+    }
+    bool boundPressed(int pad, const char *ps2Name)
+    {
+        const PadBinding *b = boundTo(pad, ps2Name);
+        if (!b)
+            return false;
+        return (b->gamepad && IsGamepadAvailable(pad) && IsGamepadButtonPressed(pad, b->gamepad)) ||
+               (pad == 0 && ((b->key && IsKeyPressed(b->key)) || (b->key2 && IsKeyPressed(b->key2))));
+    }
+    bool boundDown(int pad, const char *ps2Name)
+    {
+        const PadBinding *b = boundTo(pad, ps2Name);
+        if (!b)
+            return false;
+        return (b->gamepad && IsGamepadAvailable(pad) && IsGamepadButtonDown(pad, b->gamepad)) ||
+               (pad == 0 && ((b->key && IsKeyDown(b->key)) || (b->key2 && IsKeyDown(b->key2))));
+    }
+
+    void updateGfxMenu(bool allowR3)
+    {
+        GfxMenu &m = g_gfxMenu;
+        const char step = gfxScriptStep();
+        const auto pressedOn = [](int pad, int button) { return IsGamepadAvailable(pad) && IsGamepadButtonPressed(pad, button); };
+        const auto pressed = [&m, step, &pressedOn](int button)
+        {
+            const char want = button == GAMEPAD_BUTTON_RIGHT_THUMB ? 'o' : button == GAMEPAD_BUTTON_LEFT_FACE_UP ? 'u'
+                            : button == GAMEPAD_BUTTON_LEFT_FACE_DOWN ? 'd' : button == GAMEPAD_BUTTON_LEFT_FACE_LEFT ? 'l'
+                            : button == GAMEPAD_BUTTON_LEFT_FACE_RIGHT ? 'r' : button == GAMEPAD_BUTTON_RIGHT_FACE_DOWN ? 'x'
+                            : button == GAMEPAD_BUTTON_RIGHT_FACE_RIGHT ? 'c' : button == GAMEPAD_BUTTON_LEFT_TRIGGER_1 ? 'q'
+                            : button == GAMEPAD_BUTTON_RIGHT_TRIGGER_1 ? 'e' : 0;
+            // o botão do PS2 que esse botão padrão representa, como o jogador mapeou (controle e teclado)
+            const char *ps2 = button == GAMEPAD_BUTTON_LEFT_FACE_UP ? "CIMA" : button == GAMEPAD_BUTTON_LEFT_FACE_DOWN ? "BAIXO"
+                            : button == GAMEPAD_BUTTON_LEFT_FACE_LEFT ? "ESQUERDA" : button == GAMEPAD_BUTTON_LEFT_FACE_RIGHT ? "DIREITA"
+                            : button == GAMEPAD_BUTTON_RIGHT_FACE_DOWN ? "X" : button == GAMEPAD_BUTTON_RIGHT_FACE_RIGHT ? "CIRCULO"
+                            : button == GAMEPAD_BUTTON_LEFT_TRIGGER_1 ? "L1" : button == GAMEPAD_BUTTON_RIGHT_TRIGGER_1 ? "R1"
+                            : button == GAMEPAD_BUTTON_RIGHT_THUMB ? "R3" : nullptr;
+            return (step != 0 && step == want) || (ps2 ? boundPressed(m.pad, ps2) : pressedOn(m.pad, button));
+        };
+        if (!m.open)
+        {
+            const bool r3Pad2 = allowR3 && boundPressed(1, "R3"); // o jogador 2 abre com o R3 do controle dele (o mapeado)
+            m.pad = r3Pad2 ? 1 : 0;
+            if (IsKeyPressed(KEY_F1) || r3Pad2 || (allowR3 && (step == 'o' || boundPressed(0, "R3"))))
+            {
+                m.open = true, m.row = 0, m.confirmReset = false;
+                m.rpgPlayer = m.pad; // cada jogador vê só o próprio RPG: o do controle que abriu a janela
+                const mksm_rpg::Snapshot me = mksm_rpg::snapshot(m.rpgPlayer);
+                if (me.active && me.freePoints > 0) // subiu de nível: pausa, R3, distribui
+                    m.tab = TabRpg;
+            }
+        }
+        else if (m.capture >= 0)
+            updateCapture();
+        else
+        {
+            const mksm_rpg::Snapshot rpg = mksm_rpg::snapshot(m.rpgPlayer);
+            const int tabs = rpg.active ? static_cast<int>(TabCount) : static_cast<int>(TabRpg); // a aba RPG só num jogo RPG
+            if (m.tab >= tabs)
+                m.tab = TabGfx, m.row = 0;
+            if (pressed(GAMEPAD_BUTTON_LEFT_TRIGGER_1))
+                m.tab = (m.tab + tabs - 1) % tabs, m.row = 0, m.confirmReset = false;
+            if (pressed(GAMEPAD_BUTTON_RIGHT_TRIGGER_1))
+                m.tab = (m.tab + 1) % tabs, m.row = 0, m.confirmReset = false;
+            const int rows = m.tab == TabGfx ? static_cast<int>(RowCount) : m.tab == TabCtl ? static_cast<int>(CtlRowCount) : static_cast<int>(RpgRowCount);
+            const int oldRow = m.row;
+            if (pressed(GAMEPAD_BUTTON_LEFT_FACE_UP))
+                m.row = (m.row + rows - 1) % rows;
+            if (pressed(GAMEPAD_BUTTON_LEFT_FACE_DOWN))
+                m.row = (m.row + 1) % rows;
+            if (m.tab == TabRpg && !rpg.active) // save normal: só a mensagem e "Fechar"
+                m.row = RpgClose;
+            if (m.row != oldRow)
+                m.confirmReset = false;
+            const bool left = pressed(GAMEPAD_BUTTON_LEFT_FACE_LEFT);
+            const bool right = pressed(GAMEPAD_BUTTON_LEFT_FACE_RIGHT);
+            const bool accept = pressed(GAMEPAD_BUTTON_RIGHT_FACE_DOWN);
+            const bool back = pressed(GAMEPAD_BUTTON_RIGHT_FACE_RIGHT) || pressed(GAMEPAD_BUTTON_RIGHT_THUMB) ||
+                              IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_BACKSPACE) || IsKeyPressed(KEY_F1);
+            const int closeRow = m.tab == TabGfx ? static_cast<int>(RowClose) : m.tab == TabCtl ? static_cast<int>(CtlClose) : static_cast<int>(RpgClose);
+            if (back || (accept && m.row == closeRow))
+                m.open = false;
+
+            else if (m.tab == TabRpg)
+            {
+                if (accept && m.row < mksm_rpg::AttrCount)
+                    mksm_rpg::addPoint(m.rpgPlayer, m.row);
+                else if (accept && m.row == RpgReset) // X duas vezes: devolve todos os pontos
+                {
+                    if (m.confirmReset)
+                        mksm_rpg::resetPoints(m.rpgPlayer);
+                    m.confirmReset = !m.confirmReset;
+                }
+            }
+            else if (m.tab == 0 && (left || right || accept) && (m.row != RowReset || accept))
+                changeGfxRow(m.row, left ? -1 : 1);
+            else if (m.tab == TabCtl && accept && m.row == CtlReset)
+            {
+                std::copy(padBindingDefaults(), padBindingDefaults() + kPadBindingCount, padBindings(m.pad));
+                m.saveTried = true;
+                m.saved = saveGfx();
+            }
+            else if (m.tab == TabCtl && accept && m.row < kPadBindingCount)
+                m.capture = m.row, m.captureArmed = false;
+        }
+        // The buttons that closed the menu must not reach the game either: wait until they are let go.
+        bool held = false;
+        for (int pad = 0; pad < 2; ++pad)
+            for (int button = GAMEPAD_BUTTON_LEFT_FACE_UP; IsGamepadAvailable(pad) && button <= GAMEPAD_BUTTON_RIGHT_THUMB; ++button)
+                held = held || IsGamepadButtonDown(pad, button);
+        for (const int key : {KEY_ESCAPE, KEY_ENTER, KEY_BACKSPACE, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT})
+            held = held || IsKeyDown(key);
+        m.waitRelease = m.open || (m.waitRelease && held);
+        g_gfxBlockInput.store(m.waitRelease, std::memory_order_relaxed);
+    }
