+        const uint16_t minU = (clamp >> 4) & 0x3FFu, maxU = (clamp >> 14) & 0x3FFu;
+        const uint16_t minV = (clamp >> 24) & 0x3FFu, maxV = (clamp >> 34) & 0x3FFu;
