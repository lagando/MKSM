+    // Versalete como o "Select Difficulty" do jogo: a inicial de cada palavra grande, o resto em maiúsculas menores.
+    // Devolve a largura; com draw=false só mede.
+    float smallCaps(const char *text, float x, float y, float size, Color color, bool draw = true, bool shadow = true)
+    {
+        const Font &f = overlayFont();
+        const float small = size * 0.78f, spacing = size * 0.04f, start = x, drop = std::max(1.0f, size / 14.0f);
+        bool wordStart = true;
+        for (const char *c = text; *c;)
+        {
+            int bytes = 1;
+            int cp = GetCodepointNext(c, &bytes);
+            c += bytes;
+            const bool big = wordStart;
+            wordStart = cp == ' ';
+            if ((cp >= 'a' && cp <= 'z') || (cp >= 0xE0 && cp <= 0xFE && cp != 0xF7))
+                cp -= 32;
+            const float s = big ? size : small, top = y + (size - s) * 0.8f; // mesma linha de base
+            if (draw && cp != ' ')
+            {
+                if (shadow)
+                    DrawTextCodepoint(f, cp, Vector2{x + drop, top + drop}, s, Color{0, 0, 0, static_cast<unsigned char>(color.a * 0.8f)});
+                DrawTextCodepoint(f, cp, Vector2{x, top}, s, color);
+            }
+            const GlyphInfo g = GetGlyphInfo(f, cp);
+            x += (g.advanceX != 0 ? g.advanceX : GetGlyphAtlasRec(f, cp).width) * s / f.baseSize + spacing;
+        }
+        return x - start;
+    }
+
+    void smallCapsCentered(const char *text, float cx, float y, float size, Color color)
+    {
+        smallCaps(text, cx - smallCaps(text, 0, 0, size, color, false) / 2, y, size, color);
+    }
+
+    // Quadro no estilo do diálogo do jogo: azul-escuro translúcido com moldura dupla clara.
+    void drawGamePanel(Rectangle r, float alpha = 1.0f)
+    {
+        const float t = std::max(1.0f, r.height / 70.0f);
+        const auto a = [alpha](int v) { return static_cast<unsigned char>(v * alpha); };
+        DrawRectangleRec(r, Color{12, 22, 56, a(185)});
+        DrawRectangleLinesEx(r, 1.5f * t, Color{186, 186, 196, a(225)});
+        DrawRectangleLinesEx(Rectangle{r.x + 4 * t, r.y + 4 * t, r.width - 8 * t, r.height - 8 * t}, t, Color{186, 186, 196, a(90)});
+    }
+
+    // Texto do HUD do jogo: versalete com contorno escuro, como o "EXP:" e os nomes em cima das barras.
+    float hudText(const char *text, float x, float y, float size, Color color, bool draw = true)
+    {
+        if (draw)
+        {
+            const float o = std::max(1.0f, size / 13.0f);
+            const Color edge{18, 12, 4, color.a};
+            for (int dx = -1; dx <= 1; ++dx)
+                for (int dy = -1; dy <= 1; ++dy)
+                    if (dx != 0 || dy != 0)
+                        smallCaps(text, x + dx * o, y + dy * o, size, edge, true, false);
+        }
+        return smallCaps(text, x, y, size, color, draw, false);
+    }
+
+    // Barra fina no estilo das do HUD: fundo escuro, moldura metálica, enchimento com brilho em cima.
+    void hudBar(Rectangle r, float frac, Color fill)
+    {
+        frac = std::clamp(frac, 0.0f, 1.0f);
+        const float e = std::max(1.0f, r.height / 6.0f);
+        DrawRectangleRec(Rectangle{r.x - 2 * e, r.y - 2 * e, r.width + 4 * e, r.height + 4 * e}, Color{18, 12, 4, 220});
+        DrawRectangleLinesEx(Rectangle{r.x - e, r.y - e, r.width + 2 * e, r.height + 2 * e}, e, Color{176, 170, 160, 230});
+        DrawRectangleRec(r, Color{30, 26, 40, 230});
+        DrawRectangleRec(Rectangle{r.x, r.y, r.width * frac, r.height}, fill);
+        DrawRectangleRec(Rectangle{r.x, r.y, r.width * frac, r.height * 0.35f},
+                         Color{static_cast<unsigned char>(std::min(255, fill.r + 50)), static_cast<unsigned char>(std::min(255, fill.g + 50)),
+                               static_cast<unsigned char>(std::min(255, fill.b + 60)), fill.a});
+    }
