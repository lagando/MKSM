+# PGO do runtime e do IOP (PLANO_DESEMPENHO N22, B1), nunca no código gerado: PS2X_PGO=gerar compila com contadores e
+# o jogo grava o perfil em PS2X_PGO_DIR (PS2X_PGO_DUMP_AT=<s> grava e sai); PS2X_PGO=usar recompila com o perfil.
+# -fprofile-partial-training mantém otimizado o código que o treino não visitou; -fprofile-correction aceita os
+# contadores desencontrados por 1 ou 2 (o perfil é gravado com as outras threads rodando); -Wno-coverage-mismatch
+# ignora o perfil só onde o código mudou (o PS2X_PGO_DUMP_AT da initialize só existe no treino). Vazio = build normal.
+set(PS2X_PGO "" CACHE STRING "PGO do runtime: vazio, gerar ou usar")
+set(PS2X_PGO_DIR "${CMAKE_BINARY_DIR}/pgo" CACHE PATH "Pasta do perfil do PGO")
+# MinGW: a libgcov do sistema (a do Arch) é reduzida, só com a contagem de caminhos; o perfil sai sem o perfil de valores e
+# o de tempo (iguais no gerar e no usar) e o runtime grava os arquivos ele mesmo (pgoWriteAll no ps2_runtime.cpp).
+set(PS2X_PGO_EXTRA "")
+if(MINGW)
+    # -fprofile-prefix-path: o perfil fica com nomes relativos à pasta de compilação, e o do pacote do Windows
+    # (vendor/pgo, gravado aqui) serve em qualquer pasta do PC de quem instala.
+    set(PS2X_PGO_EXTRA -fno-profile-values -fno-profile-reorder-functions -fprofile-prefix-path=${CMAKE_BINARY_DIR})
+endif()
+if(PS2X_PGO STREQUAL "gerar" AND NOT MSVC)
+    foreach(pgo_target ps2_runtime ps2_iop)
+        target_compile_options(${pgo_target} PRIVATE -fprofile-generate=${PS2X_PGO_DIR} -fprofile-update=prefer-atomic ${PS2X_PGO_EXTRA})
+    endforeach()
+    target_link_options(ps2_runtime INTERFACE -fprofile-generate=${PS2X_PGO_DIR})
+    target_compile_definitions(ps2_runtime PRIVATE PS2X_PGO_GEN=1)
+elseif(PS2X_PGO STREQUAL "usar" AND NOT MSVC)
+    foreach(pgo_target ps2_runtime ps2_iop)
+        target_compile_options(${pgo_target} PRIVATE -fprofile-use=${PS2X_PGO_DIR} -fprofile-partial-training -fprofile-correction ${PS2X_PGO_EXTRA}
+                               -Wno-missing-profile -Wno-coverage-mismatch)
+    endforeach()
+endif()
