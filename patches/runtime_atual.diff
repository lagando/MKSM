+            unpack(packet, 0x8000u, 0x33u); // FLG: TOPS + 0
+            mem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+            t.Equals(seen.size(), static_cast<size_t>(1u), "the program should run once");
+            t.Equals(seen[0], 0u, "the program should read its buffer before the next UNPACK overwrites it");
+        });
