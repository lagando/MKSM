diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 589d768..6a20797 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -462,6 +462,18 @@ else()
     )
 endif()
 
+# Game-specific override for Mortal Kombat: Shaolin Monks.
+#
+# This file only defines a static initializer (PS2_REGISTER_GAME_OVERRIDE).
+# `ps2_runtime` is a STATIC library and the build does not use WHOLE_ARCHIVE,
+# so an unreferenced object would be dropped by the linker and the override
+# would never run. Compile it directly into the executable instead.
+#
+# See PLANO.md (Etapa 1) and src/lib/game_overrides_mksm.cpp.
+target_sources(ps2EntryRunner PRIVATE
+    "${CMAKE_CURRENT_SOURCE_DIR}/src/lib/game_overrides_mksm.cpp"
+)
+
 if(PS2X_ENABLE_RUNNER_UNITY_BUILD)
     set_target_properties(ps2EntryRunner PROPERTIES
         UNITY_BUILD ON
