+        const float u1f = static_cast<float>(v1.u >> 4), v1f = static_cast<float>(v1.v >> 4);
+        const float spriteW = static_cast<float>(spanX), spriteH = static_cast<float>(spanY);
+        for (int x = job.x0; x <= job.x1; ++x)
