+        job.x0 = clampInt(unclippedX0, ctx.scissor.x0, ctx.scissor.x1);
+        job.y0 = clampInt(unclippedY0, ctx.scissor.y0, ctx.scissor.y1);
+        job.x1 = clampInt(unclippedX1, ctx.scissor.x0, ctx.scissor.x1);
+        job.y1 = clampInt(unclippedY1, ctx.scissor.y0, ctx.scissor.y1);
