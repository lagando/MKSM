+void GSCpuBackend::MarkVramWritten(uint32_t blockBase, uint32_t bufferWidth, uint32_t psm, uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1)
+{
+    if (m_vramSize == 0u)
+        return;
+    ++m_writeSerial;
+    forEachPage(blockBase, std::max<uint32_t>(bufferWidth, 1u), psm, x0, y0, x1, y1, m_vramSize / 8192u, [&](uint32_t page)
+                { m_pageSerial[page] = m_writeSerial; });
+}
