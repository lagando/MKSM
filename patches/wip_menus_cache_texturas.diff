+const uint32_t *GSCpuBackend::DecodedTexture(const GSDrawState &state, uint64_t pixelArea)
+{
+    const auto &tex = state.context.tex0;
+    const uint32_t texW = state.textureWidth, texH = state.textureHeight;
+    const uint32_t texelCount = texW * texH;
+    if (m_textureVram != m_vram || texelCount > kMaxDecodedTexels || m_vramSize == 0u)
+        return nullptr;
+
+    const bool indexed = isFourBitIndexedPsm(tex.psm) || isEightBitIndexedPsm(tex.psm);
+    const uint64_t key0 = static_cast<uint64_t>(tex.tbp0) | (static_cast<uint64_t>(tex.tbw) << 14) |
+                          (static_cast<uint64_t>(tex.psm) << 20) | (static_cast<uint64_t>(texW) << 26) |
+                          (static_cast<uint64_t>(texH) << 38);
+    const uint64_t key1 = (indexed ? static_cast<uint64_t>(tex.cpsm) | (static_cast<uint64_t>(tex.csm) << 8) |
+                                         (static_cast<uint64_t>(tex.csa) << 16)
+                                   : 0u) |
+                          (static_cast<uint64_t>(state.texa.ta0) << 24) | (static_cast<uint64_t>(state.texa.aem) << 32) |
+                          (static_cast<uint64_t>(state.texa.ta1) << 40);
+
+    uint64_t pageSerial = 0u;
+    forEachPage(tex.tbp0, tex.tbw, tex.psm, 0u, 0u, texW - 1u, texH - 1u, m_vramSize / 8192u, [&](uint32_t page)
+                { pageSerial = std::max(pageSerial, m_pageSerial[page]); });
+    const uint64_t clutSerial = indexed ? m_clutSerial : 0u;
+
+    DecodedTextureEntry *entry = nullptr;
+    for (DecodedTextureEntry &candidate : t_textureCache)
+    {
+        if (candidate.key[0] == key0 && candidate.key[1] == key1)
+        {
+            entry = &candidate;
+            break;
+        }
+        if (!entry || candidate.lastUse < entry->lastUse)
+            entry = &candidate;
+    }
+    if (entry->key[0] != key0 || entry->key[1] != key1 || entry->pageSerial != pageSerial ||
+        entry->clutSerial != clutSerial || entry->epoch != m_vramEpoch)
+    {
+        entry->key[0] = key0, entry->key[1] = key1;
+        entry->pageSerial = pageSerial, entry->clutSerial = clutSerial, entry->epoch = m_vramEpoch;
+        entry->pendingArea = 0u;
+        entry->decoded = false;
+    }
+    entry->lastUse = ++t_textureClock;
+
+    if (!entry->decoded)
+    {
+        // Decode only once the draws using it cover a good part of it: a large texture
+        // read by a few small primitives is cheaper to sample directly.
+        entry->pendingArea += pixelArea;
+        if (entry->pendingArea * 4u < texelCount)
+            return nullptr;
+        entry->texels.resize(texelCount);
+        for (uint32_t v = 0u; v < texH; ++v)
+            for (uint32_t u = 0u; u < texW; ++u)
+                entry->texels[v * texW + u] = FetchTexel(state, static_cast<int>(u), static_cast<int>(v));
+        entry->decoded = true;
+    }
+    return entry->texels.data();
+}
